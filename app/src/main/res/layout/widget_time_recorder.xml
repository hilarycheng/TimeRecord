<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="38 —    42C —"
        android:textColor="#B9FFF4"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/widget_smart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="下一步"
        android:textColor="#FFF5FA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/widget_smart_bg"
        android:paddingHorizontal="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_38"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="38"
            android:textColor="#A5F5E9"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/widget_bus_bg" />

        <TextView android:layout_width="8dp" android:layout_height="1dp" android:text="" />

        <TextView
            android:id="@+id/widget_42c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="42C"
            android:textColor="#A5F5E9"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/widget_bus_bg" />
    </LinearLayout>
</LinearLayout>
